generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: connection pooler (ex.: porta 6543 no Supabase) — usada pela app em runtime.
// DIRECT_URL: conexão direta (ex.: porta 5432) — usada só pelo Prisma Migrate, que precisa
// de prepared statements que o pooler do Supabase não suporta.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Auth.js (obrigatório: nomes e campos seguem o adaptador @auth/prisma-adapter) ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  tasks         Task[]
  transactions  Transaction[]
  bills         RecurringBill[]
  appointments  Appointment[]
  documents     DocumentNote[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Domínio do app (cada registro pertence a um usuário) ----

enum Priority {
  alta
  media
  baixa
}

enum TaskStatus {
  pending
  completed
}

enum TransactionType {
  income
  expense
}

model Task {
  id       String     @id @default(cuid())
  userId   String
  title    String
  date     String
  time     String?
  priority Priority
  status   TaskStatus @default(pending)
  notes    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  description String
  amount      Float
  date        String
  category    String
  account     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecurringBill {
  id      String  @id @default(cuid())
  userId  String
  name    String
  amount  Float
  dueDate String
  paid    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Appointment {
  id       String  @id @default(cuid())
  userId   String
  title    String
  date     String
  time     String
  location String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DocumentNote {
  id        String   @id @default(cuid())
  userId    String
  title     String
  category  String
  content   String   @db.Text
  updatedAt String
  aiAccess  Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Histórico do conselheiro de investimentos: dado de mercado público, não pertence
// a um usuário específico — por isso sem userId, diferente dos modelos acima.
model InvestmentHistoryEntry {
  id               String   @id @default(cuid())
  ticker           String
  score            Int
  fundamentals     Int
  sentiment        Int
  asOf             DateTime
  demo             Boolean
  createdAt        DateTime @default(now())

  @@index([ticker])
  @@index([createdAt])
}
