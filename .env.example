# Banco de dados (Postgres — ex.: Supabase). Obrigatório: sem isso, nenhuma rota de dados funciona.
# DATABASE_URL: connection pooler do Supabase (porta 6543, com ?pgbouncer=true).
# DIRECT_URL: conexão direta do Supabase (porta 5432) — só usada por `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# Auth.js — login com Google. Gere AUTH_SECRET com `npx auth secret` (ou qualquer string aleatória longa).
# Crie o client OAuth em https://console.cloud.google.com/apis/credentials, com redirect URI
# http://localhost:3000/api/auth/callback/google (ajuste o domínio em produção).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Conselheiro de investimentos (opcional). Sem essas chaves, o módulo usa dados demonstrativos.
BRAPI_TOKEN=
MARKETAUX_API_KEY=
