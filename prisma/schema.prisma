generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: connection pooler (ex.: porta 6543 no Supabase) — usada pela app em runtime.
// DIRECT_URL: conexão direta (ex.: porta 5432) — usada só pelo Prisma Migrate, que precisa
// de prepared statements que o pooler do Supabase não suporta.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Auth.js (obrigatório: nomes e campos seguem o adaptador @auth/prisma-adapter) ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  tasks         Task[]
  transactions  Transaction[]
  bills         RecurringBill[]
  appointments  Appointment[]
  documents     DocumentNote[]
  watchlist     WatchlistItem[]
  budgetCategories BudgetCategory[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Domínio do app (cada registro pertence a um usuário) ----

enum Priority {
  alta
  media
  baixa
}

enum TaskStatus {
  pending
  completed
}

enum TransactionType {
  income
  expense
}

model Task {
  id       String     @id @default(cuid())
  userId   String
  title    String
  date     String
  time     String?
  priority Priority
  status   TaskStatus @default(pending)
  notes    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  description String
  amount      Float
  date        String
  category    String
  account     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecurringBill {
  id      String  @id @default(cuid())
  userId  String
  name    String
  amount  Float
  dueDate String
  paid    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Appointment {
  id       String  @id @default(cuid())
  userId   String
  title    String
  date     String
  time     String
  location String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DocumentNote {
  id        String   @id @default(cuid())
  userId    String
  title     String
  category  String
  content   String   @db.Text
  updatedAt String
  aiAccess  Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Estimativa mensal de gasto "não mapeado" (transporte, lazer, futilidades — coisas
// que normalmente não viram um Transaction lançado um a um). Alimenta o cálculo do
// orçamento diário em src/domain/daily-budget.ts. Sem período: é um valor vivo que
// o usuário mantém, dividido proporcionalmente pelos dias do mês no cálculo.
model BudgetCategory {
  id            String   @id @default(cuid())
  userId        String
  name          String
  monthlyAmount Float
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Watchlist personalizada por usuário do conselheiro de investimentos. Quem não
// tem nenhuma linha aqui cai na watchlist padrão fixa no código (ver watchlist.ts).
model WatchlistItem {
  id         String    @id @default(cuid())
  userId     String
  ticker     String
  name       String
  assetClass AssetClass
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
}

enum AssetClass {
  acao
  fii
}

// Contador de rate limiting. Uma linha por (escopo + identificador + janela de tempo);
// a janela fica embutida na própria chave, então nunca precisa de reset — só cresce e
// é limpa por rate-limit.ts. Não pertence a usuário nenhum, é infraestrutura.
model RateLimitEntry {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime

  @@index([windowStart])
}

// Histórico do conselheiro de investimentos: dado de mercado público, não pertence
// a um usuário específico — por isso sem userId, diferente dos modelos acima.
// priceAtScoring/realizedReturnPct/evaluatedAt sustentam a comparação entre o
// score dado e o retorno real observado depois (ver server/investments/history.ts).
// Entradas antigas (antes desse campo existir) e entradas demo ficam com esses
// três campos nulos pra sempre — não tem preço real pra comparar.
model InvestmentHistoryEntry {
  id                String    @id @default(cuid())
  ticker            String
  score             Int
  fundamentals      Int
  sentiment         Int
  asOf              DateTime
  demo              Boolean
  priceAtScoring    Float?
  realizedReturnPct Float?
  evaluatedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([ticker])
  @@index([createdAt])
}
